<resources>

    <!--
        Weft — SplashTheme

        Applied to MainActivity before React Native loads. Shows a dark
        background with the Weft logo centered. Switches to AppTheme
        immediately when the JS bundle is ready (handled in MainActivity.kt).

        Place your logo at:
          android/app/src/main/res/drawable/splash_logo.png
        Or per density:
          drawable-mdpi/    (48dp)
          drawable-hdpi/    (72dp)
          drawable-xhdpi/   (96dp)
          drawable-xxhdpi/  (144dp)
          drawable-xxxhdpi/ (192dp)
    -->
    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
        Weft — AppTheme
        
        A launcher must own the full screen. We achieve this by:
        1. Transparent status bar and navigation bar so Weft draws underneath both
        2. windowLayoutInDisplayCutoutMode = shortEdges so content extends into notch area
        3. Disabling the window background so React Native's own background shows
        4. Keeping NoActionBar so there's no system toolbar
        
        The nav bar and status bar icon colors are controlled at runtime from JS
        via StatusBar API and our WeftSystemUIModule.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">

        <!-- Remove the default white window background — RN provides its own -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <!-- Status bar: fully transparent, icons handled by RN StatusBar API -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Navigation bar: fully transparent so Weft draws behind it -->
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Draw behind both bars — this is what makes it truly edge-to-edge -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Extend layout into the display cutout (notch) area -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- Keep the EditText background for React Native text inputs -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>

    </style>

</resources>
