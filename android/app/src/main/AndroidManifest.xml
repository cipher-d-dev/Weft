<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required by react-native-launcher-kit on Android 11+ (API 30+) to
         enumerate installed apps. Without this, getApps() returns an empty
         list on API 30+ devices. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Read the system wallpaper so it shows behind the launcher UI.
         Android 13+ (API 33+) uses READ_WALLPAPER_INTERNAL instead of
         READ_EXTERNAL_STORAGE for this purpose. Both are declared so the
         correct one is used on each API level. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_WALLPAPER_INTERNAL"
        android:minSdkVersion="33" />

    <!-- Allows setting wallpapers — some devices also require this to READ
         the wallpaper via WallpaperManager.getDrawable(). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Lets Weft receive a broadcast when the device finishes booting,
         so it can restore any background state after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Haptic feedback on icon long-press (optional but improves feel). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Brightness control — WRITE_SETTINGS lets us set screen brightness.
         On Android 6+ the user must also grant "Modify system settings" in
         Settings → Apps → Special app access. We prompt them if not granted. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Bluetooth toggle — BLUETOOTH_CONNECT required on Android 12+ (API 31+)
         to enable/disable the adapter. On older versions BLUETOOTH_ADMIN suffices. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        android:minSdkVersion="31" />

    <!-- Do Not Disturb — ACCESS_NOTIFICATION_POLICY lets us read and set the
         interruption filter. The user must grant "Do Not Disturb access" in
         Settings → Apps → Special app access. We prompt them if not granted. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Flashlight — CAMERA lets us use CameraManager.setTorchMode().
         No runtime permission dialog is shown for torch-only use on most devices,
         but the manifest declaration is required. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- WiFi state read — needed on Android 9 and below for getWifiEnabled(). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:taskAffinity=""
        android:windowSoftInputMode="adjustResize"
        android:exported="true"
        android:stateNotNeeded="true"
        android:theme="@style/SplashTheme">
        <!-- Standard app launcher intent — shows Weft in the app drawer -->
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Home/launcher role — makes Weft appear in "Choose default launcher"
             and respond to the Home button press.
             Both HOME and DEFAULT are required; HOME alone is not sufficient. -->
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>
      </activity>
    </application>
</manifest>
