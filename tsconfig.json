{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@tokens/*": ["src/tokens/*"],
      "@compose/*": ["src/compose/*"],
      "@context/*": ["src/context/*"],
      "@components/*": ["src/components/*"],
      "@surfaces/*": ["src/surfaces/*"],
      "@navigation/*": ["src/navigation/*"],
      "@hooks/*": ["src/hooks/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
